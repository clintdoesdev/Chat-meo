generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BotStatus {
  DRAFT
  LIVE
}

enum WidgetPosition {
  BOTTOM_LEFT
  BOTTOM_RIGHT
}

// Purely visual: which platform-styled header/background/bubble treatment the widget renders.
// Independent of primaryColor — a preset sets both together, but editing the color afterward
// doesn't fall back to DEFAULT, since "WhatsApp look with a custom accent" is a valid combo.
enum WidgetTheme {
  DEFAULT
  WHATSAPP
  TELEGRAM
}

enum ConversationStatus {
  OPEN
  RESOLVED
  HANDOFF
}

enum MessageRole {
  BOT
  USER
  AGENT
}

enum MessageContentType {
  TEXT
  IMAGE
}

// Which channel a message was sent/received over. Defaults to WEB so every message from before
// this field existed (and every widget/test-drawer turn today) needs no backfill. Only the
// WhatsApp webhook (src/app/api/webhooks/whatsapp/route.ts) ever writes WHATSAPP explicitly.
enum MessageChannel {
  WEB
  WHATSAPP
}

// Meta's outbound delivery lifecycle for one specific WhatsApp message — see
// Message.deliveryStatus's doc comment. Ordered so a later, out-of-order status webhook can never
// regress an already-more-advanced state (see processStatusUpdate in the webhook route).
enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  TWO_FACTOR
}

enum TwoFactorMethod {
  EMAIL
  TOTP
}

// Reflects Meta's own connection health for this number (token revoked, number disconnected in
// Meta Business Manager, etc.) — distinct from WhatsAppConnection.isActive, which is the seller's
// own pause/live toggle. A connection can be CONNECTED but isActive: false (seller paused it), or
// isActive: true but TOKEN_EXPIRED (seller never paused, Meta cut it off) — the two track
// different things and shouldn't be collapsed into one flag.
// BANNED is set from the "account_update" webhook field (see processAccountEvent in
// src/app/api/webhooks/whatsapp/route.ts) when Meta disables the WABA — isActive is forced false
// alongside it, and flips back to CONNECTED/true automatically if Meta later reinstates it.
enum WhatsAppConnectionStatus {
  CONNECTED
  DISCONNECTED
  TOKEN_EXPIRED
  BANNED
}

model User {
  id                  String           @id @default(cuid())
  name                String
  email               String           @unique
  passwordHash        String?
  image               String?
  emailVerified       DateTime?
  twoFactorEnabled    Boolean          @default(false)
  twoFactorMethod     TwoFactorMethod?
  totpSecret          String?
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime         @default(now())
  /// Notifications (handoff conversations across the user's bots) created after this timestamp
  /// count as unread — see src/components/app/notifications-menu.tsx. Null means everything is
  /// unread, same as never having opened the panel.
  notificationsReadAt DateTime?

  bots                Bot[]
  verificationCodes   VerificationCode[]
  conversationFolders ConversationFolder[]
  pushSubscriptions   PushSubscription[]
  deviceTokens        DeviceToken[]

  @@map("users")
}

/// One row per native-app install this user is signed into — an FCM registration token,
/// registered by the Android app (see src/app/api/v1/push/register/route.ts) once it has both a
/// Bearer token (signed in) and a token from Firebase. Distinct from PushSubscription (that one's
/// the *browser's* Web Push subscription, a different delivery mechanism entirely) — sending a
/// push notification means fanning out to both tables, one per channel. `token` unique rather
/// than `[userId, token]`: FCM can hand the same token to a different signed-in user after a
/// sign-out/sign-in-as-someone-else on the same device, and re-registering should move it to the
/// new owner, not collide.
model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

/// One row per browser/device the user has enabled push notifications on (a user can have
/// several — desktop, phone, multiple browsers). `endpoint` is the push service's per-device
/// URL, already unique by construction, so it's also the natural key for re-subscribing (see
/// subscribeToPush in src/lib/actions/push.ts) and for pruning a device the browser has dropped.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model VerificationCode {
  id         String              @id @default(cuid())
  userId     String
  purpose    VerificationPurpose
  codeHash   String
  expiresAt  DateTime
  attempts   Int                 @default(0)
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_codes")
}

model Bot {
  id             String         @id @default(cuid())
  userId         String
  name           String
  slug           String         @unique
  status         BotStatus      @default(DRAFT)
  primaryColor   String         @default("#FF5C16")
  /// Shown in the widget header and dashboard bot list in place of the default mark. Either a
  /// plain image URL, or a base64 data: URI from an in-app upload — no blob storage in this app,
  /// so an uploaded file's bytes live directly in this column (size-capped client-side).
  avatarUrl      String?
  /// Which platform-styled treatment the widget's header/background/bubbles use. See the
  /// WidgetTheme enum doc for why this is independent of primaryColor.
  theme          WidgetTheme    @default(DEFAULT)
  welcomeMessage String?
  widgetPosition WidgetPosition @default(BOTTOM_RIGHT)
  /// Permissive mode for the embeddable widget: while true, the origin allowlist check in
  /// src/lib/chat/origin-check.ts is skipped when BotApiKey.allowedDomains is still empty, so a
  /// bot owner can test the widget (e.g. on the dashboard preview or test-embed.html) before
  /// they've configured a real domain. Flipped off automatically the first time a domain is
  /// added (see addAllowedDomain in src/lib/actions/embed.ts) — from then on, an empty
  /// allowedDomains list means "no domain configured yet," not "anything goes."
  testMode       Boolean        @default(true)
  /// Whether the Flow Studio saves this bot's flow automatically (debounced, ~1.2s after each
  /// edit) or only when the author explicitly clicks Save. Defaults to true so existing bots and
  /// new ones keep today's autosave behavior unless the author opts into manual saves.
  studioAutosave Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  flows              Flow[]
  conversations      Conversation[]
  apiKeys            BotApiKey[]
  whatsappConnection WhatsAppConnection?
  whatsAppShortLinks WhatsAppShortLink[]
  pythonBot          PythonBot?

  @@index([userId])
  @@map("bots")
}

/// A bot owner's own Python file, run in an isolated sandbox (see src/lib/python-bot/sandbox.ts)
/// in place of the Flow Studio graph entirely — the "whole-bot bypass" mode. At most one per Bot.
/// While `enabled`, both runChatTurn (widget) and runWhatsAppTurn skip loading/stepping the Flow
/// graph altogether and hand each inbound message straight to this code instead; a Bot with no
/// PythonBot row (or one with enabled: false) behaves exactly as before this feature existed.
model PythonBot {
  id        String   @id @default(cuid())
  botId     String   @unique
  /// The script itself, run fresh in a new sandbox on every turn (see Conversation.pythonState
  /// for how it keeps memory across turns despite that) — see src/lib/python-bot/sandbox.ts's
  /// RUNNER_SOURCE for the exact contract (chatmeo_input in, chatmeo_reply/chatmeo_state out).
  code      String   @db.Text
  enabled   Boolean  @default(false)
  /// The most recent run's error message (a script exception, a sandbox failure, malformed
  /// output), if the last turn failed — cleared on the next successful run. Surfaced in the
  /// Studio's Python Bot page so an owner can tell a silent production failure apart from the
  /// bot legitimately having nothing to say.
  lastError String?  @db.Text
  lastRunAt DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("python_bots")
}

model Flow {
  id        String   @id @default(cuid())
  botId     String
  name      String
  graph     Json
  isActive  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  bot       Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)
  documents AiNodeDocument[]

  @@index([botId])
  @@map("flows")
}

model Conversation {
  id            String             @id @default(cuid())
  botId         String
  visitorId     String
  status        ConversationStatus @default(OPEN)
  /// Serialized engine EngineState ({ currentNodeId, variables, status }) — see src/engine/types.ts.
  engineState   Json               @default("{}")
  /// When the customer last messaged in, per the channel's own delivered timestamp (not when we
  /// finished processing it) — see src/lib/whatsapp/service-window.ts. Only ever set by the
  /// WhatsApp webhook today; null for widget conversations, which have no such window to track.
  lastInboundAt DateTime?
  /// Purely an Inbox organization concept — hides a conversation from the default list without
  /// touching `status`, which the engine (runWhatsAppTurn/run-turn) reads to decide whether to
  /// keep replying. Archiving a HANDOFF or OPEN conversation doesn't change bot behavior at all.
  archived      Boolean            @default(false)
  /// The seller has blocked this visitor — the engine never runs and never replies for a blocked
  /// conversation (same skip as HANDOFF — see runWhatsAppTurn), and it's excluded from "new
  /// message" push notifications, but an inbound message still gets stored so the seller keeps a
  /// record of what was sent. Purely our own concept: WhatsApp's Business Platform has no
  /// business-blocks-customer API of its own (only the reverse), so this is enforced entirely on
  /// our side by ignoring the customer rather than by anything Meta does differently.
  blocked       Boolean            @default(false)
  folderId      String?
  /// The Python Bot's own free-form memory for this conversation (see PythonBot above) — whatever
  /// its script last returned as `chatmeo_state`, round-tripped verbatim on the next turn. Plays
  /// the same role `engineState` plays for the Flow graph engine, but is never read by it (and
  /// vice versa) — a Bot only ever uses one or the other, decided by PythonBot.enabled at the
  /// moment each turn runs.
  pythonState   Json               @default("{}")
  createdAt     DateTime           @default(now())

  bot      Bot                 @relation(fields: [botId], references: [id], onDelete: Cascade)
  folder   ConversationFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([botId])
  @@index([botId, visitorId, status])
  @@index([folderId])
  @@map("conversations")
}

// Purely a seller-side organizational label spanning all of that seller's bots (the Inbox
// itself already spans bots) — folders have no effect on engine/bot behavior, unlike `status`.
model ConversationFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([userId, name])
  @@map("conversation_folders")
}

model Message {
  id               String             @id @default(cuid())
  conversationId   String
  role             MessageRole
  /// For TEXT messages, the message text. For IMAGE messages, a `data:` URI of the downloaded
  /// image bytes — no blob storage in this app (see Bot.avatarUrl's doc comment above), so an
  /// inbound WhatsApp image's bytes live directly in this column, same as an uploaded avatar's.
  content          String             @db.Text
  contentType      MessageContentType @default(TEXT)
  /// Only set for an IMAGE message that had one — WhatsApp lets a customer attach text alongside
  /// a photo, which is worth keeping but doesn't belong in `content` (the image data itself).
  caption          String?            @db.Text
  /// Only set for BOT messages produced by an "ai" node whose provider reported token usage —
  /// see src/engine/llm.ts. Null for message-node replies, USER messages, etc.
  promptTokens     Int?
  completionTokens Int?
  channel          MessageChannel     @default(WEB)
  createdAt        DateTime           @default(now())
  /// Meta's own message id (`wamid...`) — for an inbound message, captured off the webhook
  /// payload so a seller's "reply to this message" (see replyToId below) can pass it back as
  /// WhatsApp's own `context.message_id`; for an outbound one (BOT/AGENT), captured off Meta's
  /// send response so later status webhooks (see deliveryStatus) and the Inbox's own reactions
  /// can reference *this* message. Never set for a WEB-channel message.
  waMessageId      String?
  /// Set when this message was sent as an explicit reply to an earlier one in the same
  /// conversation — the Inbox's swipe/reply-to-message action (src/lib/actions/inbox.ts). SetNull
  /// rather than cascading: deleting the quoted message shouldn't take this reply down with it,
  /// just drop the quote.
  replyToId        String?
  /// Starred for later — purely an Inbox organization concept, like Conversation.archived; has no
  /// effect on engine/bot behavior.
  starred          Boolean            @default(false)
  /// Emoji the customer reacted with on WhatsApp (a native WhatsApp reaction, delivered as its own
  /// inbound webhook event) — null means no reaction, or one since removed (Meta reports removal
  /// as a reaction event with an empty emoji). Keyed by the *target* message's waMessageId, so
  /// this can land on a message of any role, not just ones from the customer.
  customerReaction String?
  /// Emoji the seller picked from the Inbox's own reaction picker — mirrors customerReaction but
  /// from our side; sent to WhatsApp via sendWhatsAppReaction (meta-graph.ts) when this message
  /// has a waMessageId to react to.
  agentReaction    String?
  /// Outbound-only (BOT/AGENT role on a WHATSAPP-channel message): Meta's delivery lifecycle for
  /// this specific message, from its own status webhooks (sent → delivered → read, or failed).
  /// Null for a WEB-channel message (no such concept) or before Meta's first status callback
  /// arrives — see processStatusUpdate in the webhook route.
  deliveryStatus   MessageDeliveryStatus?
  /// True when this message was created by the Inbox's "forward" action rather than typed or
  /// replied directly — purely a "Forwarded" display label, no effect on delivery.
  forwarded        Boolean            @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReplies")

  @@index([conversationId])
  @@index([waMessageId])
  @@map("messages")
}

model AiNodeDocument {
  id        String   @id @default(cuid())
  flowId    String
  /// The AI node's id within Flow.graph — not a foreign key, since nodes live inside the
  /// graph JSON rather than as their own rows. Deleting/recreating a node orphans its docs,
  /// same as any other per-node data already does when a node is removed from the graph.
  nodeId    String
  fileName  String
  /// Extracted plain text, capped (see src/lib/documents/extract-text.ts) — we keep the text
  /// used for AI context, not the original file bytes.
  content   String   @db.Text
  charCount Int
  createdAt DateTime @default(now())

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@index([flowId, nodeId])
  @@map("ai_node_documents")
}

model BotApiKey {
  id             String   @id @default(cuid())
  botId          String
  publicKey      String   @unique
  allowedDomains String[]
  createdAt      DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@map("bot_api_keys")
}

// The WhatsApp channel is independent of the widget's BotApiKey — a Bot can run one, the other,
// both, or neither. One number per Bot (botId unique) and one Bot per number (phoneNumberId
// unique) — Meta issues a distinct phoneNumberId per WhatsApp Business number, so this doubles as
// the fast, join-free lookup inbound webhooks route by (findUnique on phoneNumberId hits its own
// unique index directly, no Bot -> User traversal needed).
model WhatsAppConnection {
  id                 String                   @id @default(cuid())
  botId              String                   @unique
  wabaId             String
  phoneNumberId      String                   @unique
  displayPhoneNumber String
  /// AES-256-GCM ciphertext (iv:authTag:ciphertext, base64 — see src/lib/crypto.ts), Meta's
  /// long-lived access token for this number. Encrypted with WHATSAPP_TOKEN_ENCRYPTION_KEY, a
  /// key deliberately separate from AUTH_SECRET/secret-crypto.ts's — rotating one never forces
  /// rotating (or breaks decryption of) the other. Cleared to null on disconnect (see
  /// disconnectWhatsApp in src/lib/actions/whatsapp.ts) — a revoked connection has no token
  /// worth keeping around, encrypted or not.
  accessToken        String?
  status             WhatsAppConnectionStatus @default(CONNECTED)
  /// The seller's own pause/live toggle — independent of `status` (Meta's connection health).
  /// While false, the webhook still receives and stores inbound messages for the Inbox, but the
  /// runtime engine must not process them or auto-reply.
  isActive           Boolean                  @default(true)
  connectedAt        DateTime                 @default(now())
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@map("whatsapp_connections")
}

/// A WhatsApp click-to-chat link: visiting /l/{slug} redirects straight to a WhatsApp chat with
/// this bot's connected number, message box already filled in with `message` — e.g. for pasting
/// into ads, bios, or posts. See src/app/l/[slug]/route.ts.
model WhatsAppShortLink {
  id    String @id @default(cuid())
  botId String
  /// Random, URL-safe, unique across all bots (the redirect route looks up by this alone, not
  /// scoped to a bot) — see newShortLinkSlug in src/lib/actions/whatsapp-short-links.ts.
  slug  String @unique
  /// The seller's own name for this link (e.g. "Instagram bio", "Facebook ad") — never shown to
  /// whoever clicks it, just for telling links apart in the management list.
  label String
  /// Pre-filled into WhatsApp's message box for whoever clicks the link — they still have to hit
  /// send themselves, same as any wa.me link.
  message String @db.Text
  /// Snapshot (E.164 digits, no leading +) of the bot's connected WhatsApp number at the moment
  /// this link was created — kept even if the bot's connection is later replaced or disconnected,
  /// so a link already shared out in the world keeps pointing at the right number.
  phoneNumber String
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())

  bot Bot @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([botId])
  @@map("whatsapp_short_links")
}
