# PostgreSQL connection string (Railway)
DATABASE_URL="postgresql://user:password@host:5432/chatmeo"

# NextAuth v5
# Generate with: openssl rand -base64 33
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth provider
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend (transactional email + beta feedback)
RESEND_API_KEY=""
EMAIL_FROM="Chatmeo <noreply@yourdomain.com>"
# Where the "Beta feedback" widget (dashboard) sends submissions. Feedback is silently dropped
# (with a console warning) if this isn't set — no separate Feedback table for now.
FEEDBACK_EMAIL_TO=""

# AI provider for the Flow Studio runtime engine's AI response nodes AND the Logic node's
# semantic matching (both src/lib/ai/providers.ts and src/engine/llm.ts go through this same
# config). Both providers are OpenAI-compatible APIs, so switching between them is just this
# config — no code changes needed. Set explicitly to "xai" or "openrouter" — recommended, since
# it's unambiguous. If left unset (or set to something unrecognized), it falls back to whichever
# provider actually has a key configured (XAI_API_KEY or OPENROUTER_API_KEY below); if both or
# neither are set, that fallback defaults to "xai".
#
# "openrouter" is the free-to-run option: its default model below (deepseek/deepseek-chat-v3:free)
# costs nothing per call, on OpenRouter's own free tier (sign up at https://openrouter.ai, no
# credit card required for :free models — just note their generous but real rate limits, so a
# high-traffic bot may eventually want a paid model instead). "xai" (Grok) is billed per-token
# on your xAI account — if XAI_API_KEY runs out of credit or is invalid, every AI reply AND every
# Logic node semantic match silently fails (falls back to a generic apology / no match at all,
# logged server-side but not surfaced anywhere in the Studio UI yet) — that failure mode looks
# exactly like "pattern matching doesn't work" even though the matching logic itself is fine.
AI_PROVIDER="openrouter"
# Optional: overrides the active provider's default model id (e.g. "grok-4.3" for xai, or any
# OpenRouter model slug like "anthropic/claude-3.5-sonnet", or another free one like
# "meta-llama/llama-3.3-70b-instruct:free", for openrouter). Leave unset to use the provider's
# built-in default (a free model for openrouter).
AI_MODEL=""

# xAI Grok — required when AI_PROVIDER=xai. Paid — see the AI_PROVIDER comment above.
XAI_API_KEY=""
# OpenRouter — required when AI_PROVIDER=openrouter. Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Signs/verifies Bearer tokens for the native mobile app's REST API (src/lib/mobile-auth/,
# src/app/api/v1/) — deliberately a separate secret from AUTH_SECRET (the web session's own
# NextAuth JWT), so rotating one never signs out the other's users.
# Generate with: openssl rand -base64 33
MOBILE_API_JWT_SECRET=""

# Encrypts WhatsAppConnection.accessToken at rest (src/lib/crypto.ts) — deliberately a separate
# key from AUTH_SECRET, so rotating it never invalidates sessions and vice versa.
# Generate with: openssl rand -base64 33
WHATSAPP_TOKEN_ENCRYPTION_KEY=""

# WhatsApp Embedded Signup (src/lib/whatsapp/meta-graph.ts) — connects a bot to a seller's
# WhatsApp Business number via Meta's Facebook Login for Business flow. All three come from the
# Meta App Dashboard (see README's "WhatsApp Business setup" section for exact steps); the
# "WhatsApp" tab in a bot's settings shows a "not configured" message until all are set.
# App Dashboard → Settings → Basic → App ID
META_APP_ID=""
# App Dashboard → Settings → Basic → App Secret (click "Show") — server-only, never sent to the client
META_APP_SECRET=""
# App Dashboard → WhatsApp → Embedded Signup → Configurations → your configuration's ID
META_CONFIG_ID=""

# Web Push (browser notifications for handoffs + new inbox messages — src/lib/push/).
# Generate a pair with: npx web-push generate-vapid-keys
# Public key is read client-side (see src/components/app/push-subscription.tsx), so it must be
# prefixed NEXT_PUBLIC_; the private key is server-only and must never be exposed to the client.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact address the push service can reach you at if it flags your usage — any mailto: works.
VAPID_SUBJECT="mailto:support@chatmeo.app"

# FCM push (native Android app notifications for handoffs + new inbox messages, same triggers as
# Web Push above — src/lib/push/fcm.ts). The full contents of a Firebase service account key JSON
# (Firebase console → Project settings → Service accounts → Generate new private key), as a single
# line. Server-only — never expose this to the client. Missing this just skips FCM sends (the web
# push path above still works on its own), so it's fine to leave unset until a Firebase project
# exists.
FIREBASE_SERVICE_ACCOUNT_JSON=''

# Python Bot mode (src/lib/python-bot/) — lets a bot owner run a Python file in place of the
# Flow Studio graph. Each incoming message runs the owner's script in an isolated E2B sandbox
# (https://e2b.dev); nothing of this deployment's own secrets is ever exposed inside it. Without
# this key set, the "Bypass mode" toggle on a bot's Python Bot page stays disabled.
# Sign up at https://e2b.dev, then get a key at https://e2b.dev/dashboard?tab=keys
E2B_API_KEY=""

# Inbound WhatsApp webhook (src/app/api/webhooks/whatsapp/route.ts) — a single shared endpoint
# for every connected bot, not per-bot. Arbitrary string you choose yourself (not from Meta);
# enter the exact same value in App Dashboard → WhatsApp → Configuration → Webhook when you set
# the callback URL to https://<your-domain>/api/webhooks/whatsapp — Meta echoes it back on the
# verification handshake (GET) to prove the request came from whoever configured the webhook.
# Generate with: openssl rand -hex 24
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
