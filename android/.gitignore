# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc) — machine-specific, never shared
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log files
*.log

# Android Studio
.navigation/
captures/
*.iml
.idea/

# Keystore files — never commit a real signing key
*.jks
*.keystore

# External native build folder
.externalNativeBuild
.cxx/

# google-services.json is per-Firebase-project config, not committed — see the "Wire up FCM push
# notifications" follow-up task for how it's provided (locally, and to CI as a secret).
google-services.json
